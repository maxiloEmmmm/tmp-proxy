#!/usr/bin/env bash
# Load only the root-owned service environment before starting the daemon.
# Example: CF_TOKEN in /etc/cfp/env -> daemon registers cfp/demo.
set -euo pipefail

env_file=/etc/cfp/env
if [[ ! -r "$env_file" ]]; then
    echo "CF environment file is not readable: $env_file" >&2
    exit 1
fi

source "$env_file"
if [[ -z "${CF_TOKEN:-}" ]]; then
    echo "CF_TOKEN is missing from $env_file" >&2
    exit 1
fi
export CF_TOKEN

exec /usr/local/bin/tmp-proxy \
    -daemon \
    -key demo \
    -ip 127.0.0.1 \
    -port 22 \
    -const
