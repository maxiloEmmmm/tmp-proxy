#!/usr/bin/env bash
# Load only the root-owned service environment before starting KV-backed yy mode.
# Example: cfp/demo plus port=22 -> local 127.0.0.1:9010 proxy.
set -euo pipefail

env_file=/etc/cfp/env
if [[ ! -r "$env_file" ]]; then
    echo "CF environment file is not readable: $env_file" >&2
    exit 1
fi

source "$env_file"
if [[ -z "${CF_TOKEN:-}" ]]; then
    echo "CF_TOKEN is missing from $env_file" >&2
    exit 1
fi
export CF_TOKEN

exec /usr/local/bin/tmp-proxy \
    -yy \
    -kvk cfp/demo \
    -query port=22 \
    127.0.0.1:9010
